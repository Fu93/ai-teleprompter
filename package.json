{
  "name": "ai-teleprompter",
  "version": "0.2.0",
  "description": "AI 提詞機 — 提詞浮層 / 會議轉錄摘要 / 面試練習教練",
  "main": "./out/main/index.js",
  "author": "Fu93",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test e2e/smoke.spec.ts e2e/visual.spec.ts",
    "test:all": "npm run typecheck && vitest run && npm run e2e",
    "e2e": "npm run build && playwright test",
    "audit:ui": "node --no-warnings scripts/audit-ui.mjs",
    "audit:deep": "node --no-warnings scripts/audit-deep.mjs",
    "audit:states": "node scripts/audit-states.mjs",
    "audit:edge": "node --no-warnings scripts/audit-glass-edge.mjs",
    "audit": "npm run audit:ui && npm run audit:deep && npm run audit:states",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dexie": "^4.4.6",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  }
}
