{
  "name": "ai-teleprompter",
  "version": "0.2.0",
  "description": "AI 提詞機 — 提詞浮層 / 會議轉錄摘要 / 面試練習教練",
  "main": "./out/main/index.js",
  "author": "Fu93",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:baseline": "node --no-warnings scripts/lint-baseline.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --no-warnings scripts/run-e2e.mjs blocking",
    "test:e2e:advisory": "node --no-warnings scripts/run-e2e.mjs advisory",
    "test:e2e:all": "node --no-warnings scripts/run-e2e.mjs all",
    "release": "node --no-warnings scripts/release-gate.mjs",
    "e2e": "npm run build && npm run test:e2e:all",
    "audit:ui": "node --no-warnings scripts/audit-ui.mjs",
    "audit:deep": "node --no-warnings scripts/audit-deep.mjs",
    "audit:states": "node --no-warnings scripts/audit-states.mjs",
    "audit:edge": "node --no-warnings scripts/audit-glass-edge.mjs",
    "audit": "node --no-warnings scripts/audit-all.mjs",
    "audit:effects": "node --no-warnings scripts/audit-effects.mjs",
    "audit:selftest": "node --no-warnings scripts/audit-selftest.mjs",
    "make-audio-fixture": "node --no-warnings scripts/make-audio-fixture.mjs",
    "dist": "electron-vite build && electron-builder",
    "audit:journey": "node --no-warnings scripts/audit-journey.mjs",
    "release:checks": "node --no-warnings scripts/release-checks.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/noto-sans-tc": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dexie": "^4.4.6",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "http-cache-semantics": "^4.2.1"
  }
}
